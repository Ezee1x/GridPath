# Set to the canonical origin before building a hosted deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Browser key for Maps JavaScript API and Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Site annotations
# Detection models (Grounding DINO + Florence-2, ~1.7 GB) download from Hugging Face
# on the first analysis and are cached here. No API key is needed. Aerial imagery
# (MassGIS, USGS) and site context (US Census, MassGIS, OpenStreetMap) need no keys.
# CV_MODEL_CACHE=.cache/cv-models

# Analyzing Street View imagery is off by default: Google Maps Platform terms
# restrict analyzing or deriving data from Street View content. Set both only
# after confirming your organization's license permits it. Server-side only.
# GOOGLE_MAPS_API_KEY=
# STREET_VIEW_ANALYSIS_PERMITTED=false
