# Set to the canonical origin before building a hosted deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Browser key for Maps JavaScript API and Places API (New).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Site annotations
# Detection models (Grounding DINO + Florence-2, ~1.7 GB) download from Hugging Face
# on the first analysis and are cached here. No API key is needed. Aerial imagery
# (MassGIS, USGS) and site context (US Census, MassGIS, OpenStreetMap) need no keys.
# CV_MODEL_CACHE=.cache/cv-models

# Analyzing Street View imagery is off by default: Google Maps Platform terms
# restrict analyzing or deriving data from Street View content. Set both only
# after confirming your organization's license permits it. Server-side only.
# GOOGLE_MAPS_API_KEY=
# STREET_VIEW_ANALYSIS_PERMITTED=false

# Optional self-hosted shared workspace (Node 24+, single server, persistent disk).
# Enable all three in your deployment, restart, then initialize in Settings.
# QORE_TEAM_ENABLED=true
# QORE_DATA_DIR=/absolute/persistent/qoresites-data
# QORE_TEAM_SETUP_TOKEN=replace-with-a-long-random-secret
# Isolated image worker timeout, 1000–600000 ms; defaults to five minutes.
# QORE_VISION_TIMEOUT_MS=300000

# OpenEI Utility Rate Database v7 — request your own API key at
# https://apps.openei.org/services/doc/rest/util_rates/?version=7
# Server-side only. Never prefix this variable with NEXT_PUBLIC_.
# OPENEI_API_KEY=
